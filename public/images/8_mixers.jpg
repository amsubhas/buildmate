<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="800" height="500">
  <defs>
    <linearGradient id="g" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#152040;stop-opacity:1"/>
      <stop offset="100%" style="stop-color:#0a1628;stop-opacity:1"/>
    </linearGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="0.5"/>
    </pattern>
  </defs>
  <rect width="800" height="500" fill="url(#g)"/>
  <rect width="800" height="500" fill="url(#grid)"/>
  <rect x="340" y="220" width="120" height="60" rx="4" fill="none" stroke="rgba(35,60,130,0.6)" stroke-width="1"/>
  <text x="400" y="256" text-anchor="middle" dominant-baseline="middle"
    font-family="Arial, sans-serif" font-weight="700" font-size="14"
    fill="rgba(255,255,255,0.4)" letter-spacing="3">MIXERS</text>
  <text x="400" y="278" text-anchor="middle"
    font-family="Arial, sans-serif" font-size="9" fill="rgba(255,255,255,0.2)" letter-spacing="2">BUILDMATE.IN</text>
</svg>