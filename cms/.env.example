# Copy to `cms/.env` and replace every placeholder.
POSTGRES_DB=buildmate
POSTGRES_USER=buildmate
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
DIRECTUS_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
ADMIN_EMAIL=admin@buildmate.in
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_ADMIN_PASSWORD
DIRECTUS_PORT=8055
PUBLIC_URL=http://localhost:8055
CORS_ORIGIN=http://localhost:5173

# Production reference:
# PUBLIC_URL=https://cms.buildmate.in
# CORS_ORIGIN=https://buildmate.in,https://www.buildmate.in
# Prefer S3-compatible object storage for production media.
